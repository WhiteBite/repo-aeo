{
  "name": "repo-aeo",
  "private": true,
  "version": "0.3.0",
  "description": "Repo Discoverability Kit (RDK): make any repository, npm package and docs site maximally findable and recommendable for humans, AI agents and search engines.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "rdk": "node packages/rdk-cli/bin/rdk.js",
    "mcp": "node packages/repo-aeo-mcp/bin/repo-aeo-mcp.js serve",
    "audit": "node packages/rdk-cli/bin/rdk.js audit",
    "audit:json": "node packages/rdk-cli/bin/rdk.js audit --format json",
    "fix:dry": "node packages/rdk-cli/bin/rdk.js fix",
    "fix": "node packages/rdk-cli/bin/rdk.js fix --apply",
    "npm-surface": "node packages/rdk-cli/bin/rdk.js npm-surface",
    "github-sync": "node packages/rdk-cli/bin/rdk.js github-sync",
    "test": "node scripts/run-tests.mjs",
    "test:cli": "node scripts/run-tests.mjs packages/rdk-cli/test",
    "test:mcp": "node scripts/run-tests.mjs packages/repo-aeo-mcp/test"
  },
  "keywords": [
    "discoverability",
    "generative-engine-optimization",
    "answer-engine-optimization",
    "agent-skills",
    "llms-txt",
    "agents-md",
    "repo-metadata",
    "developer-tools",
    "cli",
    "repo-audit",
    "github-topics",
    "npm-metadata",
    "geo",
    "aeo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBite/repo-aeo.git"
  },
  "homepage": "https://github.com/WhiteBite/repo-aeo#readme",
  "bugs": {
    "url": "https://github.com/WhiteBite/repo-aeo/issues"
  }
}
