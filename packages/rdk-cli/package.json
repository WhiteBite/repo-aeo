{
  "name": "repo-aeo",
  "version": "0.3.1",
  "description": "Audit and improve repository discoverability: GitHub metadata and topics, README structure, AGENTS.md, npm package surface, llms.txt and structured data.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rdk": "bin/rdk.js",
    "repo-aeo": "bin/rdk.js"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md",
    "skills"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.mjs test",
    "prepack": "node ./prepack.mjs"
  },
  "keywords": [
    "cli",
    "discoverability",
    "repo-audit",
    "github-topics",
    "llms-txt",
    "agents-md",
    "npm-metadata",
    "geo",
    "aeo",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBite/repo-aeo.git",
    "directory": "packages/rdk-cli"
  },
  "homepage": "https://github.com/WhiteBite/repo-aeo/tree/main/packages/rdk-cli#readme",
  "bugs": {
    "url": "https://github.com/WhiteBite/repo-aeo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "WhiteBite"
}
