{
  "name": "repo-aeo-mcp",
  "version": "0.1.0",
  "description": "MCP server for continuous repository discoverability monitoring: npm search score, GitHub visibility signals, llms.txt freshness and site checks. Read-only by default.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "repo-aeo-mcp": "bin/repo-aeo-mcp.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./server.js": "./src/server.js",
    "./tools.js": "./src/tools.js",
    "./package.json": "./package.json"
  },
  "types": "./src/server.d.ts",
  "files": [
    "bin",
    "src",
    "README.md",
    "Dockerfile"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@repo-aeo/rdk-cli": "0.1.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "discoverability",
    "npm-search-score",
    "llms-txt",
    "github-topics",
    "monitoring",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBite/repo-aeo.git",
    "directory": "packages/repo-aeo-mcp"
  },
  "homepage": "https://github.com/WhiteBite/repo-aeo/tree/main/packages/repo-aeo-mcp#readme",
  "bugs": {
    "url": "https://github.com/WhiteBite/repo-aeo/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
